# ---- Unity (project lives in unity/AegisSim/) ----
# Generated by the editor on every machine; never commit.
/unity/AegisSim/[Ll]ibrary/
/unity/AegisSim/[Tt]emp/
/unity/AegisSim/[Oo]bj/
/unity/AegisSim/[Bb]uild/
/unity/AegisSim/[Bb]uilds/
/unity/AegisSim/[Ll]ogs/
/unity/AegisSim/[Uu]ser[Ss]ettings/
/unity/AegisSim/[Mm]emoryCaptures/
/unity/AegisSim/[Rr]ecordings/

# .meta files carry asset GUIDs and MUST be committed
!/unity/AegisSim/[Aa]ssets/**/*.meta

# ---- IDE / Visual Studio (regenerated by Unity) ----
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# ---- Unity build outputs ----
*.apk
*.aab
*.unitypackage
*.app
crashlytics-buildid.txt

# ---- Python (arrives at Milestone 3) ----
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ---- Large generated data: keep out of Git, document how to reproduce ----
/ml/data/raw/
/ml/data/generated/
*.pt
*.onnx
/results/**/raw/
/TestResults/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
